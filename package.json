{
  "name": "job-portal-api-gateway",
  "version": "1.0.0",
  "description": "Job Portal web client-server application with a basic API Gateway, two microservices and JSON-file NoSQL databases",
  "main": "start-all.js",
  "scripts": {
    "start": "node init && node start-all.js",
